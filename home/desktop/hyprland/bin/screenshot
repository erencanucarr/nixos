#!/usr/bin/env bash
# Ekran görüntüsü: screenshot region (alan seç) | output (imlecin olduğu ekran)
# Panoya kopyalanır ve ~/Resimler/Ekran Görüntüleri'ne kaydedilir.
set -euo pipefail
dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Ekran Görüntüleri"
mkdir -p "$dir"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"
case "${1:-region}" in
  region) grim -g "$(slurp -d -b '#0a0a0c99' -c '#e6e7eaff' -w 1)" "$file" ;;
  output) grim -o "$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name')" "$file" ;;
esac
wl-copy < "$file"
notify-send -a "Ekran görüntüsü" -i "$file" "Kopyalandı" "$(basename "$file")"
