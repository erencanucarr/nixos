_ZH_I=0 _ZH_ON=0
_zh_line() { printf '   %s%-18s%s %s%s%s\n' "$c_b" "$1" "$c_r" "$c_dim" "$2" "$c_r"; }

_zh_page() {
  local i=$1 n=${#_ZH_T[@]} k dots="" cmd desc rows=0 max=0 r
  for ((k=0; k<n; k++)); do
    r=$(grep -c . <<< "${_ZH_B[k]}"); ((r > max)) && max=$r
    if ((k == i)); then dots+="${_ZH_C[k]}●$c_r "; else dots+="$c_dim·$c_r "; fi
  done
  printf '\e[H\e[2J\n'
  printf '  %s◀%s  %s%s%-16s%s %s▶%s      %s%d / %d%s\n' \
    "$c_dim" "$c_r" "${_ZH_C[i]}" "$c_b" "${_ZH_T[i]}" "$c_r" "$c_dim" "$c_r" "$c_dim" $((i+1)) "$n" "$c_r"
  printf '  %s\n' "$dots"
  printf '  %s%s%s\n' "${_ZH_C[i]}" "────────────────────────────────────────────────────────────" "$c_r"
  while IFS=$'\t' read -r cmd desc; do
    [ -n "$cmd" ] && { _zh_line "$cmd" "$desc"; ((rows++)); }
  done <<< "${_ZH_B[i]}"
  for ((; rows < max; rows++)); do echo; done
  printf '  %s────────────────────────────────────────────────────────────%s\n' "$c_dim" "$c_r"
  printf '  %s← → sayfa  ·  istediğin komutu yazabilirsin  ·  zhelp <kelime> ara%s\n\n' "$c_dim" "$c_r"
}

zhelp() {
  if [ -n "$1" ]; then
    local k cmd desc found=0
    echo
    for ((k=0; k<${#_ZH_T[@]}; k++)); do
      while IFS=$'\t' read -r cmd desc; do
        [ -z "$cmd" ] && continue
        if [[ "${cmd,,} ${desc,,}" == *"${1,,}"* ]]; then
          ((found++)) || true
          printf '   %s%-14s%s' "${_ZH_C[k]}" "${_ZH_T[k]}" "$c_r"; _zh_line "$cmd" "$desc" | sed 's/^   //'
        fi
      done <<< "${_ZH_B[k]}"
    done
    ((found)) || err "\"$1\" ile eşleşen komut yok"
    echo; return
  fi
  _ZH_I=${_ZH_I:-0}
  _zh_page "$_ZH_I"
  _ZH_ON=2
}

_zh_next() { [[ $_ZH_ON == 1 && -z $READLINE_LINE ]] || return; _ZH_I=$(( (_ZH_I + 1) % ${#_ZH_T[@]} )); _zh_page "$_ZH_I"; }
_zh_prev() { [[ $_ZH_ON == 1 && -z $READLINE_LINE ]] || return; _ZH_I=$(( (_ZH_I - 1 + ${#_ZH_T[@]}) % ${#_ZH_T[@]} )); _zh_page "$_ZH_I"; }
_zh_tick() { ((_ZH_ON > 0)) && ((_ZH_ON--)); return 0; }
PROMPT_COMMAND="_zh_tick; $PROMPT_COMMAND"
