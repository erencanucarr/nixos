# ═══ NixOS: paketler (home/can.nix içindeki home.packages listesi) ══════
_nixpkgs_file="$NIXDIR/home/can.nix"

nixls() {
  awk '/home\.packages = with pkgs; \[/{f=1;next} f&&/^  \];/{exit} f{gsub(/^ +/,"");print}' "$_nixpkgs_file"
}

nixsearch() {
  [ -z "$1" ] && { echo "Kullanım: nixsearch <kelime>"; return 1; }
  nix search nixpkgs "$@"
}

nixadd() {
  [ -z "$1" ] && { echo "Kullanım: nixadd <paket> [paket...]"; return 1; }
  local p added=0
  for p in "$@"; do
    if nixls | grep -qx "$p"; then
      warn "$p zaten ekli"; continue
    fi
    printf '%s…%s %s kontrol ediliyor\n' "$c_dim" "$c_r" "$p"
    if ! nix eval --raw "$NIXDIR#nixosConfigurations.$NIXHOST.pkgs.$p.name" >/dev/null 2>&1; then
      err "$p diye bir paket yok (aramak için: nixsearch $p)"; continue
    fi
    sed -i "/home\.packages = with pkgs; \[/,/^  \];/ s/^  \];/    $p\n  ];/" "$_nixpkgs_file"
    ok "$p eklendi"; added=1
  done
  [ "$added" = 1 ] && _nixapply_prompt
}

nixrm() {
  [ -z "$1" ] && { echo "Kullanım: nixrm <paket> [paket...]"; return 1; }
  local p removed=0
  for p in "$@"; do
    if ! nixls | grep -qx "$p"; then
      warn "$p listede yok (listeyi gör: nixls)"; continue
    fi
    sed -i "/home\.packages = with pkgs; \[/,/^  \];/ {/^    $p\$/d}" "$_nixpkgs_file"
    ok "$p çıkarıldı"; removed=1
  done
  [ "$removed" = 1 ] && _nixapply_prompt
}

nixsave() {
  local msg="${*:-Update configuration}"
  git -C "$NIXDIR" add -A && git -C "$NIXDIR" commit -m "$msg"
}

_nixapply_prompt() {
  local a
  read -r -p "Şimdi uygulansın mı? [E/h] " a
  case "$a" in [hHnN]*) echo "Sonra uygulamak için: nixup" ;; *) nixup ;; esac
}

