backup() {
  [ -z "$1" ] && { echo "Kullanım: backup <dosya>"; return 1; }
  cp -a -- "$1" "$1.$(date +%F_%H%M).bak" && ok "$1.$(date +%F_%H%M).bak"
}

extract() {
  [ -f "$1" ] || { echo "Kullanım: extract <arşiv>"; return 1; }
  case "$1" in
    *.tar.gz|*.tgz)   tar xzf "$1" ;;
    *.tar.xz|*.txz)   tar xJf "$1" ;;
    *.tar.bz2|*.tbz2) tar xjf "$1" ;;
    *.tar.zst)        tar --zstd -xf "$1" ;;
    *.tar)            tar xf "$1" ;;
    *.zip)            unzip "$1" ;;
    *.gz)             gunzip "$1" ;;
    *.xz)             unxz "$1" ;;
    *.bz2)            bunzip2 "$1" ;;
    *.7z)             nix run nixpkgs#p7zip -- x "$1" ;;
    *.rar)            nix run nixpkgs#unrar -- x "$1" ;;
    *) err "Bu arşiv türünü tanımıyorum: $1"; return 1 ;;
  esac
}

