bind '"\e[D": "\C-x2\C-x4"'
bind '"\eOC": "\C-x1\C-x3"'
bind '"\eOD": "\C-x2\C-x4"'

# ═══ Araçları başlat ════════════════════════════════════════════════════
has zoxide   && eval "$(zoxide init bash)"
has fzf      && eval "$(fzf --bash)"
has starship && eval "$(starship init bash)"
export FZF_DEFAULT_OPTS="--layout=reverse --border=rounded --info=inline \
  --color=bg+:#283457,border:#7aa2f7,hl:#bb9af7,hl+:#bb9af7,pointer:#2ac3de,prompt:#2ac3de,marker:#9ece6a"
export BAT_THEME="TwoDark"
has bat && export MANPAGER="sh -c 'col -bx | bat -l man -p'"

# ═══ Karşılama ══════════════════════════════════════════════════════════
if [ -z "$ZGREETED" ]; then
  export ZGREETED=1
  printf '\n  %s%s Merhaba %s%s  %s%s · yardım için %szhelp%s\n\n' \
    "$c_blue" "$c_b" "$USER" "$c_r" "$c_dim" "$(LC_TIME=tr_TR.UTF-8 date '+%A, %-d %B %H:%M')" "$c_b" "$c_r"
fi
