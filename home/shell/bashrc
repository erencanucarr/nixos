hyprsunset() {
  local sunset="$HOME/.config/hypr/bin/sunset" p k cur
  if [ $# -eq 0 ]; then
    p=$("$sunset" level)
    if cur=$(hyprctl hyprsunset temperature 2>/dev/null); then
      if [ "$p" = 0 ]; then ok "hyprsunset çalışıyor, filtre kapalı (0%)"
      else ok "hyprsunset: %$p sıcaklık (${cur}K)"; fi
    else
      warn "hyprsunset çalışmıyor  ·  kayıtlı değer: %$p"
    fi
    echo "  Ayarlamak için: hyprsunset 0-100  (0 kapalı, 50 ≈ 4500K, 100 ≈ 2500K)"
    return 0
  fi
  case "$1" in -h|--help|-*) command hyprsunset "$@"; return ;; esac
  [ $# -gt 1 ] && set -- x
  k=$("$sunset" set "$1")
  case $? in
    0) ;;
    2) err "0 ile 100 arasında bir sayı yaz (ör. hyprsunset 50)"; return 1 ;;
    3) err "hyprsunset başlatılamadı"; return 1 ;;
    4) err "hyprsunset başlatılamadı (kurulu mu? nixup)"; return 1 ;;
    *) err "hyprsunset: $k"; return 1 ;;
  esac
  p=$((10#$1))
  if (( p == 0 )); then ok "Ekran filtresi kapatıldı (0%)"
  else ok "Ekran sıcaklığı: %$p (${k}K)"; fi
}
